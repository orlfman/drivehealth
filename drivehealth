#!/usr/bin/env python3
"""drivehealth: SMART health, thermals, reads/writes and filesystem usage.

  drivehealth             one snapshot (only SMART reads use sudo)
  drivehealth -w [SECS]   live view, refreshes every SECS seconds (default 2)
  drivehealth --no-sudo   skip SMART, show kernel temperatures, I/O and filesystem usage
"""

import argparse
from copy import copy
import glob
import json
import math
import os
import re
import shutil
import subprocess
import sys
import threading
import time
from collections import Counter
from concurrent.futures import ThreadPoolExecutor

SECTOR = 512         # /proc/diskstats always counts 512-byte sectors
NVME_UNIT = 512_000  # an NVMe "data unit" is 1000 x 512 bytes
TEMP_FLOOR = 20      # left end of the temperature bar, °C
BAR_WIDTH = 15
# Watch mode reads SMART about this often (seconds). Every read through sudo
# logs three journal lines, and SMART counters move slowly; kernel temps, I/O
# and filesystems still refresh every frame.
SMART_EVERY = 30
SMART_DENIED_RETRY = 300  # seconds between permission checks for the same drive
SUDO_KEEPALIVE = 60  # watch mode renews the sudo ticket this often (logs nothing)
SUDO_REFUSED = "sudo refused the SMART read"  # error prefix when sudo -n says no


def smart_period(interval):
    """Watch frames between SMART reads: the whole number of frames closest
    to SMART_EVERY seconds, so the footer can state the real cadence."""
    return max(1, math.floor(SMART_EVERY / interval + 0.5))

# ── colour ───────────────────────────────────────────────────────────────────

USE_COLOR = True
ANSI_RE = re.compile(r"\033\[[0-9;]*m")


def paint(code, s):
    return f"\033[{code}m{s}\033[0m" if USE_COLOR else str(s)


def bold(s): return paint("1", s)
def dim(s): return paint("2", s)
def green(s): return paint("32", s)
def yellow(s): return paint("33", s)
def orange(s): return paint("38;2;255;159;10", s)
def red(s): return paint("31", s)
def hot(s): return paint("1;31", s)
def blue(s): return paint("34", s)
def cyan(s): return paint("36", s)
def magenta(s): return paint("35", s)


def vlen(s):
    return len(ANSI_RE.sub("", s))


def temp_paint(t, warn, crit):
    """Green under 50°C, yellow from 50, orange within 15° of the drive's own
    warning limit, red at the limit (where it throttles), bold red at critical."""
    warn = warn or 70
    if crit and t >= crit:
        return hot
    if t >= warn:
        return red
    if t >= warn - 15:
        return orange
    if t >= 50:
        return yellow
    return green


# ── formatting ───────────────────────────────────────────────────────────────

DASH = "—"


def fmt_bytes(n, rate=False, binary=False):
    if n is None:
        return dim(DASH)
    units = ["B", "KiB", "MiB", "GiB", "TiB", "PiB"] if binary else ["B", "kB", "MB", "GB", "TB", "PB"]
    base = 1024 if binary else 1000
    v, i = float(n), 0
    while v >= base and i < len(units) - 1:
        v /= base
        i += 1
    s = f"{v:.0f}" if i == 0 or v >= 100 else f"{v:.1f}"
    return f"{s} {units[i]}" + ("/s" if rate else "")


def fmt_int(n, suffix=""):
    return dim(DASH) if n is None else f"{n:,}{suffix}"


def fmt_minutes(m):
    return f"{m} min" if m < 120 else f"{m / 60:,.0f} h"


def table(headers, rows, right=()):
    widths = [max([len(h)] + [vlen(r[i]) for r in rows]) for i, h in enumerate(headers)]

    def line(cells):
        out = []
        for i, c in enumerate(cells):
            gap = " " * (widths[i] - vlen(c))
            out.append(gap + c if i in right else c + gap)
        return "  " + "  ".join(out).rstrip()

    return [dim(line(headers))] + [line(r) for r in rows]


def section(title):
    return ["", f"{blue('▌')} {bold(title)}"]


# ── drive discovery ──────────────────────────────────────────────────────────

class Drive:
    def __init__(self, name, model, mount, label, serial=None, seq=None):
        self.name, self.model, self.mount, self.label = name, model, mount, label
        # Same name + different ident = a different device. The kernel's disk
        # sequence number is new for every attach, so it still tells two
        # same-model drives without serials apart.
        self.ident = (name, seq) if seq is not None else (name, model, serial)
        self.seq = seq
        self.cache_smart = seq is not None or bool(serial and serial.strip())
        self.frozen = False  # watch mode: identity unconfirmed, readings are old
        self.smart_round = 0
        self.smart_at = None  # elapsed seconds since boot, including system suspend
        self.info = None   # parsed SMART, or None
        self.err = None    # why SMART is missing
        self.therm = {}
        self.filesystems = []

    def same_device(self):
        """Still the disk lsblk found? Only the kernel's attach sequence can
        tell without lsblk; with no sequence number the answer is no."""
        return self.seq is not None and disk_seq(self.name) == self.seq


def walk(node):
    yield node
    for c in node.get("children") or []:
        yield from walk(c)


def disk_seq(name):
    try:
        with open(f"/sys/block/{name}/diskseq") as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        return None


LSBLK_TIMEOUT = 15   # seconds; a hung lsblk must not freeze the report


def find_drives():
    out = subprocess.run(
        ["lsblk", "-J", "-b", "-o",
         "NAME,TYPE,SIZE,LABEL,MOUNTPOINTS,MODEL,SERIAL,FSSIZE,FSUSED,FSAVAIL"],
        capture_output=True, text=True, check=True, timeout=LSBLK_TIMEOUT).stdout
    drives = []
    for d in json.loads(out)["blockdevices"]:
        if d["type"] != "disk" or re.match(r"(zram|loop|ram|sr)", d["name"]):
            continue
        # The drive is named after its main filesystem: / or /home if it holds
        # them, otherwise the biggest mounted partition.
        best = None
        filesystems = []
        for p in walk(d):
            mounts = [m for m in p.get("mountpoints") or [] if m and m.startswith("/")]
            if not mounts:
                continue
            # One path per filesystem, even with several mounts (e.g. bind
            # mounts), used by both the I/O and the usage tables.
            m = min(mounts, key=lambda m: (m != "/", m != "/home", len(m), m))
            filesystems.append((m, p.get("fssize"), p.get("fsused"), p.get("fsavail")))
            rank = (m == "/", m == "/home", p.get("size") or 0)
            if best is None or rank > best[0]:
                best = (rank, m, p.get("label"))
        mount = best[1] if best else None
        label = (best[2] if best else None) or \
            ("root" if mount == "/" else os.path.basename(mount) if mount else d["name"])
        drive = Drive(d["name"], d.get("model") or "?", mount, label, d.get("serial"),
                      disk_seq(d["name"]))
        drive.filesystems = filesystems
        drives.append(drive)

    def key(dr):
        m = dr.mount or ""
        return (0 if m == "/" else 1 if m == "/home" else 2 if m else 3, m, dr.name)
    return sorted(drives, key=key)


def short_model(m):
    m = re.sub(r"\s+with Heatsink", "", m or "?")
    m = m.replace("Samsung SSD ", "Samsung ").replace("WD_BLACK ", "WD Black ")
    return re.sub(r"\b(\d+)000GB\b", r"\1TB", m)


# ── SMART ────────────────────────────────────────────────────────────────────

# smartctl exit-status bits (man smartctl, EXIT STATUS)
RC_CMDLINE = 0x01   # command line didn't parse
RC_OPEN = 0x02      # device open failed, or it's asleep (-n standby)
RC_CMDFAIL = 0x04   # a SMART/ATA command failed, or a checksum error
RC_FAILING = 0x08   # overall health verdict: DISK FAILING
RC_PREFAIL = 0x10   # a pre-failure attribute is at or below its threshold right now
# 0x20 (failed in the past) and 0x40/0x80 (error and self-test logs) are history,
# not a current failure, and are covered by the JSON details instead.


# Resolve the two commands used for privileged reads from system directories.
SYSTEM_PATH = os.pathsep.join(("/usr/sbin", "/usr/bin", "/sbin", "/bin"))
SMARTCTL = shutil.which("smartctl", path=SYSTEM_PATH)
SUDO = shutil.which("sudo", path=SYSTEM_PATH)


def smartctl(name):
    """Returns (json, exit status, error text); json is None on failure."""
    if not SMARTCTL:
        return None, None, "smartctl not installed"
    if not name or name in (".", "..") or os.path.basename(name) != name:
        return None, None, "invalid block device name"
    cmd = [SMARTCTL, "--json", "-H", "-i", "-A"]
    if not name.startswith("nvme"):
        cmd += ["-l", "error", "-l", "devstat", "-n", "standby"]
    via_sudo = os.geteuid() != 0
    if via_sudo:
        if not SUDO:
            return None, None, "sudo not installed for SMART reads"
        cmd = [SUDO, "-n", "--", *cmd]
    try:
        # No terminal on stdin: sudo would otherwise open a pty for every read
        # and relay keystrokes into it. The cached ticket still applies.
        r = subprocess.run(cmd + ["/dev/" + name], stdin=subprocess.DEVNULL,
                           capture_output=True, timeout=20)
    except subprocess.TimeoutExpired:
        return None, None, "smartctl timed out"
    except OSError as e:
        return None, None, f"smartctl failed: {e.strerror or e}"
    try:
        j = json.loads(r.stdout)
    except (json.JSONDecodeError, UnicodeDecodeError):
        j = None
    if not isinstance(j, dict):
        msg = f"smartctl gave no usable output (exit status {r.returncode})"
        if via_sudo and r.returncode == 1:
            # smartctl prints JSON even for its own errors, so exit 1 with no
            # JSON is sudo saying no (password needed, not allowed, ...).
            msg = SUDO_REFUSED
        if r.returncode == 1 and getattr(r, "stderr", None):
            msg += ": " + " ".join(r.stderr.decode(errors="replace").split())[:240]
        return None, r.returncode, msg
    return j, r.returncode, None


def smart_messages(j):
    messages = sub(j, "smartctl").get("messages")
    if not isinstance(messages, list):
        return []
    return [m["string"] for m in messages
            if isinstance(m, dict) and isinstance(m.get("string"), str) and m["string"]]


def mul(a, b):
    return a * b if isinstance(a, int) and not isinstance(a, bool) else None


def sub(j, key):
    v = j.get(key)
    return v if isinstance(v, dict) else {}


def as_int(v):
    return v if isinstance(v, int) and not isinstance(v, bool) else None


def as_temp(v):
    v = as_int(v)
    return v if v is not None and -40 < v < 150 else None


def base_info(j):
    passed = sub(j, "smart_status").get("passed")
    model = j.get("model_name")
    return dict(
        passed=passed if isinstance(passed, bool) else None, notes=[],  # only a real bool counts
        model=model if isinstance(model, str) else None, wear=None, spare=None, spare_thr=None,
        media=None, errlog=None, unsafe=None,
        hours=as_int(sub(j, "power_on_time").get("hours")), cycles=as_int(j.get("power_cycle_count")),
        life_read=None, life_written=None,
        temp=as_temp(sub(j, "temperature").get("current")), sensors=[],
        warn=None, crit=None, time_hot=None,
        prefail_now=False,   # a pre-failure attribute's JSON says it is failing now
        verdict_note="")     # where a FAILED verdict came from, if not the JSON


def parse_nvme(j):
    log = sub(j, "nvme_smart_health_information_log")
    n = lambda k: as_int(log.get(k))
    i = base_info(j)
    sensors = log.get("temperature_sensors")
    i.update(
        wear=n("percentage_used"),
        spare=n("available_spare"),
        spare_thr=n("available_spare_threshold"),
        media=n("media_errors"),
        errlog=n("num_err_log_entries"),
        unsafe=n("unsafe_shutdowns"),
        hours=n("power_on_hours") if n("power_on_hours") is not None else i["hours"],
        cycles=n("power_cycles") if n("power_cycles") is not None else i["cycles"],
        life_read=mul(log.get("data_units_read"), NVME_UNIT),
        life_written=mul(log.get("data_units_written"), NVME_UNIT),
        temp=as_temp(log.get("temperature")) if as_temp(log.get("temperature")) is not None else i["temp"],
        sensors=[t for t in map(as_temp, sensors if isinstance(sensors, list) else []) if t is not None],
        time_hot=n("warning_temp_time"))
    cw = n("critical_warning") or 0
    for bit, txt in ((0x01, "spare flash below threshold"), (0x04, "reliability degraded"),
                     (0x08, "drive has gone read-only"), (0x10, "volatile backup failed"),
                     (0x20, "persistent memory read-only")):
        if cw & bit:
            i["notes"].append(("fail", f"critical warning: {txt}"))
    if cw & 0x02:
        i["notes"].append(("warn", "over its temperature limit right now"))
    if n("critical_comp_time"):
        i["notes"].append(("warn", f"{fmt_minutes(n('critical_comp_time'))} spent above "
                                   "critical temperature (lifetime)"))
    return i


def devstat(j):
    out = {}
    for page in j.get("ata_device_statistics", {}).get("pages", []):
        for e in page.get("table", []):
            if "value" in e:
                out[e["name"]] = e["value"]
    return out


# SATA attribute IDs mean different things per vendor (233 is wear on Intel but
# GiB written on others, 241 counts LBAs, 32 MiB or GiB...). smartctl's drive
# database renames them per model, so pick by that name, never by ID alone.
# Wear attributes whose normalized value is "% of rated life left", by ID and
# name together (Media_Wearout_Indicator at 230 is a different encoding).
WEAR_ATTRS = ((177, "Wear_Leveling_Count"), (233, "Media_Wearout_Indicator"),
              (231, "SSD_Life_Left"), (202, "Percent_Lifetime_Remain"))
SPARE_NAMES = ("Used_Rsvd_Blk_Cnt_Tot", "Used_Rsrvd_Blk_Cnt_Tot", "Available_Reservd_Space")
# Error counters, matched by name at whatever ID the vendor put them: OCZ has
# CRC errors at 210 and uses 198/199 for GiB read/written, others put CRC at
# 218 or uncorrectables at 160/195. A name not listed here is never counted.
# Only plain counts belong in these lists: no rates, no packed raw values, no
# factory bad blocks.
MEDIA_NAMES = {
    "reallocated": (
        "Reallocated_Sector_Ct", "Retired_Block_Count", "Runtime_Bad_Block",
        "Realloc_Flash_Blocks_Ct", "Reallocate_NAND_Blk_Cnt", "Reallocated_Block_Count",
        "New_Bad_Blk_Cnt", "Later_Bad_Block", "Later_Bad_Block_Count", "Total_Later_Bad_Blk_Ct",
        "Grown_Bad_Block_Count", "Grown_Bad_Block_Ct", "Grown_Bad_Blocks",
        "Grown_Failing_Block_Ct"),
    "uncorrectable": (
        "Reported_Uncorrect", "Reported_Uncorr_Errors", "Reported_UE_Counts",
        "Uncorrectable_Error_Cnt", "Uncorrectable_Err_Ct", "Uncorrectable_ECC_Ct",
        "Uncorrectable_ECC_Cnt", "ECC_Uncorr_Error_Count", "Uncorrectable_Sectors",
        "UECC_Sector_Count", "UECC_Ct", "Lifetime_UECC_Ct",
        "Total_Unc_NAND_Reads", "Total_Unc_Read_Failures"),
    "pending": ("Current_Pending_Sector", "Pending_Sector_Count", "Current_Pending_ECC_Cnt"),
    "offline uncorrectable": (
        "Offline_Uncorrectable", "Offline_UErr_Media_Scan", "Uncor_Read_Error_Ct",
        "Uncorrectable_Sector_Ct"),
}
DEVSTAT_ERRORS = (("reallocated", "Number of Reallocated Logical Sectors"),
                  ("uncorrectable", "Number of Reported Uncorrectable Errors"))
CRC_NAMES = ("UDMA_CRC_Error_Count", "CRC_Error_Count", "CRC_Errors", "SATA_CRC_Error_Count",
             "SATA_CRC_Error", "SATA_FIS_CRC_Errors", "SATA_Error_Ct_CRC")
UNSAFE_NAMES = ("POR_Recovery_Count", "Unexpect_Power_Loss_Ct", "Unsafe_Shutdown_Count",
                "Unexpected_Pwr_Loss_Ct", "Unexpected_Power_Loss", "Unclean_Shutdown_Ct",
                "Power-Off_Retract_Count")
WRITE_NAMES = ("Total_LBAs_Written", "Host_Writes_32MiB", "Lifetime_Writes_GiB",
               "Host_Writes_GiB", "Total_Writes_GiB", "Total_Host_LBA_Written")
READ_NAMES = ("Total_LBAs_Read", "Host_Reads_32MiB", "Lifetime_Reads_GiB",
              "Host_Reads_GiB", "Total_Reads_GiB", "Total_Host_LBA_Read")


# The same raw bytes are laid out differently per attribute ("raw48" is one
# number, "raw16(raw16)" is a count plus extra words, SandForce "raw24/raw32"
# is errors/sectors). smartctl decodes that into raw.string, so the count is
# read from there: "7", "7 (0 12)" and "7/100" all mean 7. raw.value alone is
# the whole packed integer and is only trusted when there is no string.
RAW_COUNT_RE = re.compile(r"(\d+)(?:$| \(|/\d+$)")
# Without a string, the allowed names that drivedb does not store as one plain
# number are decoded by hand, the way smartctl would print them.
PACKED_RATE_NAMES = ("ECC_Uncorr_Error_Count", "Uncorrectable_Sector_Ct")  # raw24/raw32: errors/sectors
RAW16_NAMES = ("Reallocated_Sector_Ct", "Realloc_Flash_Blocks_Ct")       # raw16(raw16): count (extra words)


def raw_count(a):
    raw = sub(a, "raw")
    text, v = raw.get("string"), as_int(raw.get("value"))
    if isinstance(text, str) and text.strip():
        m = RAW_COUNT_RE.match(text.strip())
        return int(m.group(1)) if m else None   # some other format: not a count
    if v is None or v < 0:
        return None
    if a.get("name") in PACKED_RATE_NAMES:
        return v >> 32
    if a.get("name") in RAW16_NAMES:
        return v & 0xFFFF
    return v


def counter_bytes(name, v, bs):
    """Lifetime counter -> bytes, using the unit in the attribute's name."""
    if v is None:
        return None
    if "LBA" in name:
        return v * bs
    m = re.search(r"_(\d*)([MG])iB$", name)
    if m:
        return v * int(m.group(1) or 1) * (2**20 if m.group(2) == "M" else 2**30)
    return None


def parse_ata(j):
    table = sub(j, "ata_smart_attributes").get("table")
    attrs = [a for a in (table if isinstance(table, list) else []) if isinstance(a, dict)]
    by_name = {}
    for a in attrs:
        by_name.setdefault(a.get("name"), a)
    ds = devstat(j)
    bs = as_int(j.get("logical_block_size"))
    bs = bs if bs and bs > 0 else 512
    # Without a drive-database entry the names are smartctl's generic guesses,
    # so only the standard Device Statistics log is trusted for those drives.
    known = j.get("in_smartctl_database") is True
    i = base_info(j)

    def named(names, field):
        """First attribute from names with that field (value/thresh) present."""
        for n in names:
            a = by_name.get(n)
            v = None if not a else raw_count(a) if field == "raw" else as_int(a.get(field))
            if v is not None:
                return n, a, v
        return None, None, None

    def worst(names):
        """Highest raw count among the attributes carrying one of these names
        (a drive can report one kind of error twice, e.g. OCZ at 187 and 197)."""
        vals = [raw_count(a) for a in attrs if a.get("name") in names]
        return max((v for v in vals if v is not None), default=None)

    # Wear: the standard Device Statistics indicator comes first. A vendor
    # attribute is only the fallback when the drive has no such statistic,
    # with one verified exception: Samsung's 177 is the same measure without
    # the rounding, so the higher of the two is shown there.
    std_wear = as_int(ds.get("Percentage Used Endurance Indicator"))
    attr_wear = wear_id = None
    for k, name in WEAR_ATTRS if known else ():
        a = by_name.get(name)
        left = as_int(a.get("value")) if a and a.get("id") == k else None
        if left is not None and 0 <= left <= 100:
            attr_wear, wear_id = 100 - left, k
            break
    family = f"{j.get('model_name')} {j.get('model_family')}".lower()
    if std_wear is None:
        i["wear"] = attr_wear
    elif wear_id == 177 and "samsung" in family:
        i["wear"] = max(std_wear, attr_wear)
    else:
        i["wear"] = std_wear
    _, a, v = named(SPARE_NAMES, "value") if known else (None, None, None)
    if v is not None:
        i["spare"], i["spare_thr"] = v, as_int(a.get("thresh"))

    def higher(*vals):
        return max((v for v in vals if v is not None), default=None)

    # Vendor attributes and the standard statistics count the same events, so
    # the higher of the two is used rather than their sum. Like wear and
    # lifetime I/O, vendor counters are only read for drives in smartctl's
    # database: elsewhere the names are guesses and the count stays unknown.
    bad = {label: worst(names) if known else None for label, names in MEDIA_NAMES.items()}
    for label, stat in DEVSTAT_ERRORS:
        bad[label] = higher(bad[label], as_int(ds.get(stat)))
    present = {n: v for n, v in bad.items() if v is not None}
    if present:
        i["media"] = sum(present.values())
        if i["media"]:
            i["notes"].append(("warn", "bad sectors: " + ", ".join(
                f"{v:,} {n}" for n, v in present.items() if v)))

    i["errlog"] = as_int(sub(sub(j, "ata_smart_error_log"), "summary").get("count"))
    i["unsafe"] = named(UNSAFE_NAMES, "raw")[2] if known else None
    lsw = as_int(ds.get("Logical Sectors Written"))
    lsr = as_int(ds.get("Logical Sectors Read"))
    i["life_written"] = lsw * bs if lsw is not None else \
        counter_bytes(*named(WRITE_NAMES, "raw")[::2], bs) if known else None
    i["life_read"] = lsr * bs if lsr is not None else \
        counter_bytes(*named(READ_NAMES, "raw")[::2], bs) if known else None
    smax = as_int(ds.get("Specified Maximum Operating Temperature"))
    i["warn"] = smax if smax and 40 <= smax <= 120 else 70
    i["time_hot"] = as_int(ds.get("Time in Over-Temperature"))

    crc = higher(worst(CRC_NAMES) if known else None, as_int(ds.get("Number of Interface CRC Errors")))
    if crc:
        i["notes"].append(("info", f"{crc:,} interface CRC errors (cable or port, not the flash)"))
    if attrs and not known:
        i["notes"].append(("info", "model isn't in smartctl's drive database, so vendor attributes "
                                   "aren't interpreted (only standard statistics and failure flags)"))
    for a in attrs:
        aname = a.get("name") or f"#{a.get('id', '?')}"
        if a.get("when_failed") == "now":
            i["notes"].append(("fail", f"SMART attribute {aname} is failing"))
            if sub(a, "flags").get("prefailure") is not False:
                i["prefail_now"] = True
        elif a.get("when_failed") == "past":
            i["notes"].append(("info", f"SMART attribute {aname} failed in the past"))
    if i["spare"] is not None and i["spare_thr"] and i["spare"] <= i["spare_thr"]:
        i["notes"].append(("fail", "spare flash at or below threshold"))
    if not attrs and not ds:
        i["notes"].append(("info", "only the overall verdict was readable: no SMART attributes "
                                   "or statistics, so wear and error counts are unknown"))
    return i


# ── SCSI / SAS ───────────────────────────────────────────────────────────────

def is_scsi(j):
    return sub(j, "device").get("protocol") == "SCSI" or \
        any(k in j for k in ("scsi_grown_defect_list", "scsi_error_counter_log"))


def parse_scsi(j):
    i = base_info(j)
    if i["model"] is None:
        name = j.get("scsi_model_name")
        i["model"] = name if isinstance(name, str) else None
    i["wear"] = as_int(sub(j, "endurance_used").get("current_percent"))
    i["crit"] = as_temp(sub(j, "temperature").get("drive_trip"))
    if i["cycles"] is None:
        i["cycles"] = as_int(sub(j, "scsi_start_stop_cycle_counter").get("accumulated_start_stop_cycles"))

    log = sub(j, "scsi_error_counter_log")
    bad = {"grown defects": as_int(j.get("scsi_grown_defect_list")),
           "pending defects": as_int(sub(j, "scsi_pending_defects").get("count"))}
    for op in ("read", "write", "verify"):
        bad[f"uncorrected {op} errors"] = as_int(sub(log, op).get("total_uncorrected_errors"))
    present = {n: v for n, v in bad.items() if v is not None and v >= 0}
    if present:
        i["media"] = sum(present.values())
        if i["media"]:
            i["notes"].append(("warn", "bad sectors: " + ", ".join(
                f"{v:,} {n}" for n, v in present.items() if v)))
    else:
        i["notes"].append(("info", "only the overall verdict was readable: no defect list or "
                                   "error counters, so error counts are unknown"))

    def gigabytes(op):   # smartctl prints this one as a decimal string
        try:
            gb = float(sub(log, op).get("gigabytes_processed"))
        except (TypeError, ValueError):
            return None
        return round(gb * 1e9) if math.isfinite(gb) and gb >= 0 else None
    i["life_read"], i["life_written"] = gigabytes("read"), gigabytes("write")
    return i


def evaluate(i):
    n = i["notes"]
    if i["passed"] is False:
        n.insert(0, ("fail", "SMART overall health check FAILED" + i["verdict_note"]))
    if i["spare"] is not None and i["spare_thr"] and i["spare_thr"] < i["spare"] <= i["spare_thr"] + 10:
        n.append(("warn", f"spare flash down to {i['spare']}%"))
    if i["wear"] is not None and i["wear"] >= 80:
        n.append(("warn", f"{i['wear']}% of rated write endurance used"))
    if i["errlog"]:
        n.append(("info", f"{i['errlog']:,} error-log entries (often harmless; "
                          "worry if it keeps climbing)"))
    if i["time_hot"]:
        n.append(("info", f"{fmt_minutes(i['time_hot'])} spent above warning temperature (lifetime)"))
    if i["passed"] is None:
        n.append(("unknown", "the drive gave no overall health verdict, so it can't be called healthy"))
    levels = {lvl for lvl, _ in n}
    i["status"] = next((s for s in ("fail", "warn", "unknown") if s in levels), "ok")


NUMERIC_FIELDS = ("wear", "spare", "spare_thr", "media", "errlog", "unsafe", "hours", "cycles",
                  "life_read", "life_written", "temp", "warn", "crit", "time_hot")


def parse_smart_details(j):
    if isinstance(j.get("nvme_smart_health_information_log"), dict):
        i = parse_nvme(j)
        if i["media"]:
            i["notes"].append(("warn", f"{i['media']:,} media / data-integrity errors"))
        return i
    if is_scsi(j):
        return parse_scsi(j)
    if "ata_smart_attributes" in j or "smart_status" in j:
        return parse_ata(j)
    return None


def read_smart(name):
    j, rc, err = smartctl(name)
    if rc is None:
        return None, err
    if rc < 0:
        return None, f"smartctl terminated by signal {-rc}"

    failure = rc & (RC_FAILING | RC_PREFAIL)
    if j is None and not failure:
        return None, err
    msgs = smart_messages(j or {})
    if rc & (RC_CMDLINE | RC_OPEN) and not failure:
        return None, msgs[0] if msgs else f"smartctl exit status {rc}"
    try:
        i = parse_smart_details(j or {})
    except (TypeError, KeyError, ValueError, AttributeError, IndexError, OverflowError) as e:
        if not failure:
            raise
        i, err = None, f"couldn't parse SMART details ({type(e).__name__})"
    if i is None:
        if not failure:
            return None, msgs[0] if msgs else "no SMART data"
        i = base_info({})
    if err:
        i["notes"].append(("info", err))
    # The exit status carries smartctl's own verdict, even when the JSON
    # details are missing or incomplete: a failure there is never dropped.
    if rc & RC_FAILING and i["passed"] is not False:
        i["verdict_note"] = " (from smartctl's exit status; " + \
            ("its JSON verdict was missing)" if i["passed"] is None else "its JSON said passed)")
        i["passed"] = False
    if rc & RC_PREFAIL and not i["prefail_now"]:
        i["notes"].append(("fail", "smartctl reports a pre-failure attribute at or below its "
                                   "threshold, but the attribute details weren't readable"))
    # Last line of defence: everything the renderer formats as a number is one.
    for k in NUMERIC_FIELDS:
        if as_int(i[k]) is None:
            i[k] = None
    i["sensors"] = [t for t in i["sensors"] if as_temp(t) is not None]
    if not isinstance(i["model"], str):
        i["model"] = None
    if rc & RC_CMDFAIL:
        why = f": {msgs[0]}" if msgs else ""
        i["notes"].append(("unknown", f"some SMART commands failed, data may be incomplete "
                                      f"(smartctl exit status {rc}{why})"))
    evaluate(i)
    return i, None


# ── thermals and I/O ─────────────────────────────────────────────────────────

def hwmon_temps(name):
    """Temps straight from the kernel: works without root for NVMe (and SATA if
    the drivetemp module is loaded). Composite also carries the drive's own
    warning (max) and critical limits."""
    found = glob.glob(f"/sys/block/{name}/device/hwmon*/temp1_input") + \
        glob.glob(f"/sys/block/{name}/device/hwmon/hwmon*/temp1_input")
    if not found:
        return None
    h = os.path.dirname(found[0])

    def rd(p):
        try:
            with open(p) as f:
                return int(f.read().strip())
        except (OSError, ValueError):
            return None

    out = dict(temp=None, sensors=[], warn=None, crit=None)
    inputs = sorted(glob.glob(f"{h}/temp*_input"),
                    key=lambda p: int(re.search(r"temp(\d+)_input", p).group(1)))
    for p in inputs:
        base, v = p[:-len("_input")], rd(p)
        if v is None:
            continue
        v = round(v / 1000)
        try:
            with open(base + "_label") as f:
                label = f.read().strip()
        except OSError:
            label = ""
        if label == "Composite" or base.endswith("/temp1"):
            # An implausible reading is dropped so the SMART value stays.
            out["temp"] = v if -40 < v < 150 else None
            for k, dest in (("max", "warn"), ("crit", "crit")):
                x = rd(f"{base}_{k}")
                if x is not None and 0 < x / 1000 < 200:
                    out[dest] = round(x / 1000)
        elif -40 < v < 150:
            out["sensors"].append(v)
    return out


def thermals(d):
    t = dict(temp=None, sensors=[], warn=None, crit=None, time_hot=None)
    if d.info:
        t.update({k: d.info[k] for k in t})
    hw = hwmon_temps(d.name)
    if hw:
        t.update({k: v for k, v in hw.items() if v not in (None, [])})
    return t


def diskstats():
    st = {}
    with open("/proc/diskstats") as f:
        for line in f:
            p = line.split()
            st[p[2]] = (int(p[5]) * SECTOR, int(p[9]) * SECTOR, int(p[12]))
    return st


def rates(prev, cur, secs):
    """Per-second deltas. A counter that went backwards means the device was
    replaced (or the counter reset) between samples: no rate until next time."""
    out = {}
    for name, now in cur.items():
        before = prev.get(name)
        if before is None or secs <= 0 or any(c < p for c, p in zip(now, before)):
            continue
        (r, w, busy), (pr, pw, pb) = now, before
        out[name] = ((r - pr) / secs, (w - pw) / secs, min(100.0, (busy - pb) / (secs * 10)))
    return out


def collect(drives, have_smart, reuse=()):
    """Reads SMART and thermals for drives. Drives in reuse keep the SMART
    info they already carry (watch mode's cache); only thermals are re-read."""
    reuse = {id(d) for d in reuse}

    def one(d):
        # One odd drive must never take the whole report down with it.
        try:
            if id(d) in reuse:
                pass
            elif have_smart:
                d.info, d.err = read_smart(d.name)
            else:
                d.info, d.err = None, "skipped (--no-sudo)"
        except Exception as e:
            d.info, d.err = None, f"couldn't parse smartctl output ({type(e).__name__}: {e})"
        try:
            d.therm = thermals(d)
        except Exception:
            d.therm = dict(temp=None, sensors=[], warn=None, crit=None, time_hot=None)
    with ThreadPoolExecutor(max_workers=max(1, len(drives))) as ex:
        list(ex.map(one, drives))


# ── rendering ────────────────────────────────────────────────────────────────

def temp_cell(t, th):
    return dim(DASH) if t is None else temp_paint(t, th["warn"], th["crit"])(f"{t}°C")


def temp_bar(th):
    t = th["temp"]
    if t is None:
        return dim("─" * BAR_WIDTH)
    warn, crit = th["warn"], th["crit"]
    top = crit or (warn or 70) + 5
    span = max(1, top - TEMP_FLOOR)
    filled = round(max(0.0, min(1.0, (t - TEMP_FLOOR) / span)) * BAR_WIDTH)
    if t > TEMP_FLOOR:
        filled = max(1, filled)
    cells = []
    for i in range(BAR_WIDTH):
        if i < filled:
            mid = TEMP_FLOOR + span * (i + 0.5) / BAR_WIDTH
            cells.append(temp_paint(mid, warn, crit)("━"))
        else:
            cells.append(dim("─"))
    return "".join(cells)


def status_cell(d):
    if not d.info:
        return dim("n/a")
    return {"ok": green(bold("✓ OK")), "warn": yellow(bold("! WARN")),
            "unknown": yellow("? UNKNOWN"), "fail": hot("✗ FAIL")}[d.info["status"]]


def wear_cell(w):
    if w is None:
        return dim(DASH)
    s = f"{w}%"
    return green(s) if w < 50 else yellow(s) if w < 80 else orange(s) if w < 100 else red(s)


def spare_cell(s, thr):
    if s is None:
        return dim(DASH)
    thr = thr or 10
    return (green if s >= 100 else yellow if s > thr + 10 else red)(f"{s}%")


def count_cell(n, bad=red):
    return dim(DASH) if n is None else green("0") if n == 0 else bad(f"{n:,}")


def rate_cell(v, colour):
    if v is None:
        return dim(DASH)
    return dim("0 B/s") if v < 1 else colour(fmt_bytes(v, rate=True))


def busy_cell(b):
    if b is None:
        return dim(DASH)
    s = f"{b:.0f}%"
    return dim(s) if b < 1 else s if b < 50 else yellow(s) if b < 90 else orange(s)


USAGE_BAR_WIDTH = 20


def usage_paint(p):
    """Green under 70% full, yellow from 70, orange from 85, red from 95."""
    return green if p < 70 else yellow if p < 85 else orange if p < 95 else red


def usage_bar(p):
    """Fill bar for a filesystem p% full; each cell takes the colour of its
    own position, so a fuller bar runs green into red like the temp bar."""
    if p is None:
        return dim("─" * USAGE_BAR_WIDTH)
    filled = round(max(0, min(100, p)) / 100 * USAGE_BAR_WIDTH)
    if p > 0:
        filled = max(1, filled)
    return "".join(usage_paint(100 * (i + 0.5) / USAGE_BAR_WIDTH)("━") if i < filled
                   else dim("─") for i in range(USAGE_BAR_WIDTH))


def smart_refused(drives):
    """True when sudo turned down the SMART read on every listed drive."""
    return bool(drives) and all(not d.info and (d.err or "").startswith(SUDO_REFUSED)
                                for d in drives)


def render(drives, now_io, live, interval, peaks, watching, have_smart, stale=None,
           inventory_ok=True):
    """inventory_ok is False until a drive discovery has succeeded once."""
    g = lambda d, k: d.info.get(k) if d.info else None
    L = []

    # header line
    st = [d.info["status"] if d.info else "unknown" for d in drives]
    frozen = [d.label for d in drives if d.frozen]
    refused = smart_refused(drives) if have_smart else False
    if not inventory_ok:
        summary = yellow("drive inventory unavailable")
    elif not have_smart:
        summary = dim("SMART skipped (--no-sudo)")
    elif refused:
        summary = dim("SMART skipped (sudo refused)")
    elif "fail" in st:
        summary = hot(f"✗ {st.count('fail')} failing")
    elif "warn" in st:
        summary = yellow(bold(f"! {st.count('warn')} need a look"))
    elif "unknown" in st:
        summary = yellow(f"? {st.count('unknown')} not fully readable")
    elif frozen:
        summary = yellow("? listed drives healthy, drive list is stale") if stale else yellow("? drive identity unconfirmed")
    elif drives:
        summary = yellow("? listed drives healthy, drive list is stale") if stale \
            else green(bold("✓ all healthy"))
    else:
        summary = yellow("no drives found")
    head = f"  {bold('Drive health')}  {dim(time.strftime('%Y-%m-%d %H:%M:%S'))}  ·  " \
           f"{len(drives)} drives  ·  {summary}"
    temps = [d for d in drives if d.therm.get("temp") is not None and not d.frozen]
    if temps:
        h = max(temps, key=lambda d: d.therm["temp"])
        head += f"  ·  hottest {h.label} {temp_cell(h.therm['temp'], h.therm)}"
    L += ["", head]
    if stale and not inventory_ok:
        L.append(yellow(f"  ! Drive inventory unavailable ({stale}): no scan has succeeded yet"))
    elif stale:
        L.append(yellow(f"  ! couldn't refresh the drive list ({stale}): showing the drives from "
                        "the last good scan, anything attached since is missing"))
    if frozen:
        L.append(yellow(f"  ! {', '.join(frozen)}: couldn't confirm it's still the same disk. "
                        "Showing previously verified readings where available (no live I/O, peaks paused)."))

    # health
    L += section("HEALTH")
    rows = [[bold(d.label), short_model(g(d, "model") or d.model), status_cell(d),
             wear_cell(g(d, "wear")), spare_cell(g(d, "spare"), g(d, "spare_thr")),
             count_cell(g(d, "media")), count_cell(g(d, "errlog"), yellow),
             fmt_int(g(d, "unsafe")), fmt_int(g(d, "hours"), " h"), fmt_int(g(d, "cycles"))]
            for d in drives]
    L += table(["DRIVE", "MODEL", "HEALTH", "WEAR", "SPARE", "MEDIA ERR", "ERR LOG",
                "UNSAFE", "POWER-ON", "CYCLES"], rows, right=range(3, 10))
    notes = []
    # The same SMART error on every drive (e.g. sudo refused) is said once.
    errs = {d.err for d in drives if not d.info}
    shared = len(drives) > 1 and all(not d.info for d in drives) and len(errs) == 1
    if shared:
        notes.append(f"  {dim('•')} {bold('all drives')}: SMART: {errs.pop()}")
    for d in drives if not shared else ():
        for lvl, txt in (d.info["notes"] if d.info else [("info", f"SMART: {d.err}")]):
            mark = {"fail": hot("✗"), "warn": yellow("!"), "unknown": yellow("?"),
                    "info": dim("•")}[lvl]
            notes.append(f"  {mark} {bold(d.label)}: {txt}")
    if have_smart:
        L += [""] + notes if notes else []
    L.append(dim("  wear = rated write endurance used · spare = reserve flash left · "
                  "unsafe = power lost without a clean shutdown"))

    # thermals
    L += section("THERMALS")
    rows = []
    for d in drives:
        th = d.therm
        sensors = " ".join(temp_paint(s, th["warn"], th["crit"])(f"{s}°") for s in th["sensors"])
        hot_t = th["time_hot"]
        row = [bold(d.label), temp_cell(th["temp"], th), temp_bar(th), sensors or dim(DASH),
               fmt_int(th["warn"], "°C") if th["warn"] else dim(DASH),
               fmt_int(th["crit"], "°C") if th["crit"] else dim(DASH),
               dim(DASH) if hot_t is None else green("0 min") if hot_t == 0
               else yellow(fmt_minutes(hot_t))]
        if watching:
            row.append(temp_cell(peaks.get(d.name), th))
        rows.append(row)
    heads = ["DRIVE", "TEMP", f"{TEMP_FLOOR}°C → CRITICAL", "SENSORS", "WARN AT", "CRIT AT",
             "TIME ≥ WARN"] + (["PEAK"] if watching else [])
    L += table(heads, rows, right={1, 4, 5, 6, 7})
    L.append("  " + "  ".join([green("━━ under 50°C"), yellow("━━ 50°C+"),
                               orange("━━ within 15° of warn"), red("━━ at warn (throttling)"),
                               hot("━━ critical")]))

    # reads & writes
    L += section("READS & WRITES")
    rows = []
    for d in drives:
        br, bw, _ = now_io.get(d.name, (None, None, None))
        r, w, b = live.get(d.name, (None, None, None))
        rows.append([bold(d.label), dim(d.mount or DASH),
                     fmt_bytes(g(d, "life_read")), fmt_bytes(g(d, "life_written")),
                     fmt_bytes(br), fmt_bytes(bw),
                     rate_cell(r, cyan), rate_cell(w, magenta), busy_cell(b)])
    L += table(["DRIVE", "MOUNT", "READ (LIFE)", "WRITTEN (LIFE)", "READ (BOOT)",
                "WRITTEN (BOOT)", "READ NOW", "WRITE NOW", "BUSY"], rows, right=range(2, 9))

    L += section("FILESYSTEM USAGE")
    # A logical volume may appear under several physical disks in the lsblk tree.
    filesystems, on = {}, {}
    label_counts = Counter(d.label for d in drives)
    for d in drives:
        label = f"{d.label} ({d.name})" if label_counts[d.label] > 1 else d.label
        for mount, size, used, avail in d.filesystems:
            filesystems[mount] = (size, used, avail)
            on.setdefault(mount, {})[d.name] = label
    rows = []
    for mount in sorted(filesystems, key=lambda m: (m != "/", m != "/home", m)):
        size, used, avail = filesystems[mount]
        p = None
        if used is not None and avail is not None and used + avail > 0:
            # Like df, exclude reserved blocks and round the percentage up.
            p = math.ceil(100 * used / (used + avail))
        rows.append([bold(mount), dim("+".join(on[mount].values())),
                     *(fmt_bytes(n, binary=True) for n in (size, used, avail)),
                     usage_bar(p), dim(DASH) if p is None else usage_paint(p)(f"{p}%")])
    if rows:
        L += table(["MOUNT", "DRIVE", "SIZE", "USED", "AVAILABLE", "0% → FULL", "USE%"], rows,
                   right={2, 3, 4, 6})
        L.append("  " + "  ".join([green("━━ under 70%"), yellow("━━ 70%+"), orange("━━ 85%+"),
                                   red("━━ 95%+ nearly full")]))
        if len(rows) > 1:
            # Each mount contributes once. An exact total needs every reading in its column.
            size, used, avail = (
                DASH if None in column else fmt_bytes(sum(column), binary=True)
                for column in zip(*filesystems.values())
            )
            L.append(dim(f"  {len(rows)} filesystems · {size} total · {used} used · {avail} available"))
    elif not inventory_ok:
        L.append(dim("  Drive inventory unavailable."))
    else:
        L.append(dim("  No mounted filesystems on the listed drives."))

    L.append("")
    if watching:
        n = smart_period(interval)
        smart = ""
        if have_smart and not refused and drives and n > 1:
            if all(d.cache_smart for d in drives):
                smart = f" · SMART every {n * interval:g} s"
            elif any(d.cache_smart for d in drives):
                smart = f" · SMART every {n * interval:g} s (unidentified drives every frame)"
            else:
                smart = " · SMART every frame (unidentified drives)"
        L.append(dim(f"  refreshing every {interval:g} s{smart} · peak = hottest since start · Ctrl+C to quit"))
    else:
        L.append(dim(f"  'now' = {interval:.0f} s sample · drivehealth -w for a live view"))
    if not have_smart or refused:
        how = "run without --no-sudo" if not have_smart else "run again and enter the sudo password"
        L.append(dim(f"  {how} for SMART health, lifetime totals and SATA temps"))
    if refused and watching and all(d.cache_smart for d in drives):
        L.append(dim(f"  denied SMART reads retry after {SMART_DENIED_RETRY} s · new drives are checked immediately"))
    return L


# ── main ─────────────────────────────────────────────────────────────────────

def discovery_error(e):
    if isinstance(e, subprocess.TimeoutExpired):
        return f"lsblk didn't answer within {LSBLK_TIMEOUT} s"
    if isinstance(e, subprocess.CalledProcessError):
        return f"lsblk exit status {e.returncode}"
    if isinstance(e, FileNotFoundError):
        return "lsblk not found"
    return f"lsblk output unreadable, {type(e).__name__}"


def snapshot(have_smart):
    try:
        drives = find_drives()
    except Exception as e:
        sys.exit(f"drivehealth: couldn't list the drives ({discovery_error(e)})")
    prev, t0 = diskstats(), time.monotonic()
    collect(drives, have_smart)
    time.sleep(max(0.0, 1.0 - (time.monotonic() - t0)))
    cur, t1 = diskstats(), time.monotonic()
    print("\n".join(render(drives, cur, rates(prev, cur, t1 - t0), t1 - t0, {}, False, have_smart)))


class Watcher:
    """Watch-mode state. Each round is refresh(), a sleep, then frame()."""

    def __init__(self, have_smart, interval):
        self.have_smart, self.interval = have_smart, interval
        self.drives, self.peaks = [], {}
        self.last_frame = {}
        self.stale = None   # why the drive list is out of date, or None
        self.ever_ok = False   # has any discovery succeeded yet?
        self.prev, self.t0 = {}, time.monotonic()
        self.round = 0

    def refresh(self):
        # Re-discover every round: drives come and go, names get reused,
        # filesystems get mounted and unmounted.
        try:
            drives = find_drives()
        except Exception as e:
            self.stale = self.stale or f"{discovery_error(e)}, since {time.strftime('%H:%M:%S')}"
            # collect() assigns new info and therm dictionaries. Stage those
            # assignments on copies until the final identity check in frame().
            drives = [copy(d) for d in self.last_frame.values()]
            for d in drives:
                d.frozen = d.frozen or not d.same_device()
        else:
            self.stale, self.ever_ok = None, True
        self.drives = drives
        self.round += 1
        period = smart_period(self.interval)
        now = time.clock_gettime(time.CLOCK_BOOTTIME)
        live = [d for d in drives if not d.frozen]
        reuse = []
        for d in live:
            if not self.have_smart:
                continue
            previous = self.last_frame.get(d.name)
            if (d.cache_smart and previous and previous.ident == d.ident
                    and not previous.frozen and previous.smart_at is not None):
                age = now - previous.smart_at
                if (previous.err or "").startswith(SUDO_REFUSED):
                    fresh = age < SMART_DENIED_RETRY
                else:
                    fresh = self.round - previous.smart_round < period and age < period * self.interval
                if fresh:
                    d.info, d.err = previous.info, previous.err
                    d.smart_round, d.smart_at = previous.smart_round, previous.smart_at
                    reuse.append(d)
                    continue
            d.smart_round, d.smart_at = self.round, now
        collect(live, self.have_smart, reuse)

    def frame(self):
        cur, t1 = diskstats(), time.monotonic()
        io = {}
        for index, d in enumerate(self.drives):
            previous = self.last_frame.get(d.name)
            same = previous is not None and previous.ident == d.ident
            # Check after both SMART/thermal collection and the diskstats read.
            # A different attachment at any point invalidates the whole sample.
            if d.frozen or (d.seq is not None and not d.same_device()):
                if same:
                    d = self.drives[index] = previous
                else:
                    d.info, d.err = None, "device changed or disappeared during sampling"
                    d.therm = dict(temp=None, sensors=[], warn=None, crit=None, time_hot=None)
                d.frozen = True
                continue
            if not same or previous.frozen:
                self.prev.pop(d.name, None)
                # A fallback identity can describe identical replacement disks.
                if d.seq is None:
                    self.peaks.pop(d.ident, None)
            if d.name in cur:
                io[d.name] = cur[d.name]
            t = d.therm.get("temp")
            if t is not None:
                self.peaks[d.ident] = max(t, self.peaks.get(d.ident, t))
        live = rates(self.prev, io, t1 - self.t0)
        self.prev, self.t0 = io, t1
        self.last_frame = {d.name: d for d in self.drives}
        return render(self.drives, io, live, self.interval,
                      {d.name: self.peaks.get(d.ident) for d in self.drives},
                      True, self.have_smart, self.stale, self.ever_ok)


def sudo_keepalive(stop):
    """Renews the sudo ticket so watch intervals longer than sudo's timeout
    keep reading SMART. sudo -v logs nothing; stops at the first failure."""
    while not stop.wait(SUDO_KEEPALIVE):
        try:
            r = subprocess.run([SUDO, "-n", "-v"], stdin=subprocess.DEVNULL,
                               capture_output=True, timeout=10)
        except (OSError, subprocess.TimeoutExpired):
            return
        if r.returncode != 0:
            return


def watch(have_smart, interval):
    out = sys.stdout
    tty = out.isatty()   # redirected: plain frames one after another, no escapes
    stop = threading.Event()
    if have_smart and os.geteuid() != 0 and SUDO:
        threading.Thread(target=sudo_keepalive, args=(stop,), daemon=True).start()
    if tty:
        out.write("\033[?1049h\033[?25l")   # alternate screen, hide cursor
    try:
        w = Watcher(have_smart, interval)
        next_refresh = time.monotonic()
        while True:
            time.sleep(max(0.0, next_refresh - time.monotonic()))
            next_refresh = time.monotonic() + interval
            w.refresh()
            frame = w.frame()
            if tty:
                out.write("\033[H" + "\n".join(l + "\033[K" for l in frame) + "\033[J")
            else:
                out.write("\n".join(frame) + "\n")
            out.flush()
    except (KeyboardInterrupt, BrokenPipeError):
        pass
    finally:
        stop.set()
        if tty:
            out.write("\033[?25h\033[?1049l")
            out.flush()


def watch_secs(s):
    try:
        v = float(s)
    except ValueError:
        raise argparse.ArgumentTypeError(f"not a number: {s!r}")
    if not math.isfinite(v) or not 0 < v <= 86400:
        raise argparse.ArgumentTypeError(f"SECS must be more than 0 and at most 86400, got {s!r}")
    return max(0.5, v)


def main():
    global USE_COLOR
    ap = argparse.ArgumentParser(description="SMART health, thermals, reads/writes and filesystem usage.")
    ap.add_argument("-w", "--watch", nargs="?", const=2.0, type=watch_secs, metavar="SECS",
                    help="live view, refresh every SECS seconds (default 2, minimum 0.5)")
    ap.add_argument("--no-sudo", action="store_true",
                    help="skip SMART and don't ask for root (kernel temps, I/O and filesystem usage still work)")
    ap.add_argument("--color", dest="color", action="store_true", default=None)
    ap.add_argument("--no-color", dest="color", action="store_false")
    a = ap.parse_args()

    USE_COLOR = a.color if a.color is not None else \
        sys.stdout.isatty() and "NO_COLOR" not in os.environ

    have_smart = not a.no_sudo
    if have_smart and os.geteuid() != 0 and SMARTCTL and SUDO:
        # Authenticate before starting the watch screen or worker threads.
        # A redirected run can still use cached or passwordless SMART access.
        # A failed sudo -v doesn't switch SMART off: sudo can refuse -v yet
        # allow smartctl itself (a NOPASSWD rule plus verifypw). The reads
        # are still tried, and if sudo turns all of them down the header
        # says so once ("SMART skipped (sudo refused)").
        if sys.stdin.isatty() or sys.stderr.isatty():
            try:
                subprocess.run([SUDO, "-v"])
            except OSError as e:
                print(f"drivehealth: sudo validation failed: {e}", file=sys.stderr)
            except KeyboardInterrupt:
                raise SystemExit(130)

    if a.watch is not None:
        watch(have_smart, a.watch)
    else:
        snapshot(have_smart)


if __name__ == "__main__":
    main()
